FROM ubuntu:26.04

ARG GO_VERSION=1.26.4
ARG GO_SHA256_amd64=1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f
ARG DOCKER_VERSION=29.4.2
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu

ENV DEBIAN_FRONTEND=noninteractive \
    GOPATH=/go \
    GO111MODULE=off \
    PATH=/go/bin:/usr/local/go/bin:${PATH} \
    SHELL=/bin/bash

RUN set -eux; \
    find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" {} +; \
    apt-get update; \
    apt-get install -y --no-install-recommends bash ca-certificates curl gcc git libc6-dev make tar xz-utils; \
    rm -rf /var/lib/apt/lists/*; \
    rm -f /bin/sh; \
    ln -s /bin/bash /bin/sh

RUN set -eux; \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"; \
    echo "${GO_SHA256_amd64}  /tmp/go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz; \
    curl -sfL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz" | \
        tar xzf - -C /usr/bin --strip-components=1 docker/docker; \
    chmod +x /usr/bin/docker

ENV DAPPER_SOURCE=/go/src/github.com/rancher/event-subscriber
WORKDIR ${DAPPER_SOURCE}
ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
