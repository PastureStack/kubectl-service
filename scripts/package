#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"
source "$repo_root/scripts/version"
source "$repo_root/package/ubuntu-apt.lock"

KUBERNETES_VERSION=${KUBERNETES_VERSION:-v1.36.4}
KUBERNETES_GIT_COMMIT=${KUBERNETES_GIT_COMMIT:-bb826b1d48562f110659e64e8ec444327433db95}
KUBERNETES_SOURCE_SHA256=${KUBERNETES_SOURCE_SHA256:-3c28f11492472df48e658551bf268fd92938b127b0f9dcef7090ac800318c821}
KUBERNETES_LICENSE_SHA256=${KUBERNETES_LICENSE_SHA256:-cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30}
HELM_VERSION=${HELM_VERSION:-v4.2.4}
HELM_GIT_COMMIT=${HELM_GIT_COMMIT:-3900f434fd3ef2b84065dc04508df48f288dba00}
HELM_SOURCE_SHA256=${HELM_SOURCE_SHA256:-f1a1aa56fff071cfa1eecc18c6a7212b2e5c7a0a123fd8e4dcae620bd51b4286}
HELM_LICENSE_SHA256=${HELM_LICENSE_SHA256:-881467e52efeb1807406134b0ec04b1c6f52dc9dc49382713ef9ac4e0cae42f8}
HELM_ORAS_GO_VERSION=${HELM_ORAS_GO_VERSION:-2.6.2}
HELM_X_CRYPTO_VERSION=${HELM_X_CRYPTO_VERSION:-0.56.0}
HELM_PATCHED_GO_MOD_SHA256=${HELM_PATCHED_GO_MOD_SHA256:-76accd79d2f7cec3edaf79d444438d0f5bdc0b1f1fd57485a299ba5491fcb319}
HELM_PATCHED_GO_SUM_SHA256=${HELM_PATCHED_GO_SUM_SHA256:-2913265cc341d02288ad38054b13d8c6a11b185513b7169293706d0878c4f59a}

if [ -z "${SOURCE_REVISION:-}" ]; then
    SOURCE_REVISION=$(git -C "$repo_root" rev-parse HEAD)
    if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
        SOURCE_REVISION="${SOURCE_REVISION}-dirty"
    fi
fi
if ! [[ "$SOURCE_REVISION" =~ ^[0-9a-f]{40}(-dirty)?$ ]]; then
    echo "SOURCE_REVISION must be a full Git commit, optionally suffixed with -dirty" >&2
    exit 1
fi

TAG=${TAG:-${VERSION}}
REPO=${REPO:-pasturestack}
IMAGE_REPOSITORY=${IMAGE_NAME:-${REPO}/kubectl-service}
if ! [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "TAG must use numeric SemVer vMAJOR.MINOR.PATCH: $TAG" >&2
    exit 1
fi
if [[ "${IMAGE_REPOSITORY##*/}" == *:* ]]; then
    IMAGE=${IMAGE_REPOSITORY}
else
    IMAGE="${IMAGE_REPOSITORY}:${TAG}"
fi

cd "$repo_root/package"
cp ../bin/kubectl-service .
cp ../LICENSE ../SECURITY.md ../ORIGIN.md ../COMPATIBILITY.md .

build_args=(
    --build-arg "IMAGE_VERSION=${TAG}"
    --build-arg "SOURCE_REVISION=${SOURCE_REVISION}"
    --build-arg "KUBERNETES_VERSION=${KUBERNETES_VERSION}"
    --build-arg "KUBERNETES_GIT_COMMIT=${KUBERNETES_GIT_COMMIT}"
    --build-arg "KUBERNETES_SOURCE_SHA256=${KUBERNETES_SOURCE_SHA256}"
    --build-arg "KUBERNETES_LICENSE_SHA256=${KUBERNETES_LICENSE_SHA256}"
    --build-arg "HELM_VERSION=${HELM_VERSION}"
    --build-arg "HELM_GIT_COMMIT=${HELM_GIT_COMMIT}"
    --build-arg "HELM_SOURCE_SHA256=${HELM_SOURCE_SHA256}"
    --build-arg "HELM_LICENSE_SHA256=${HELM_LICENSE_SHA256}"
    --build-arg "HELM_ORAS_GO_VERSION=${HELM_ORAS_GO_VERSION}"
    --build-arg "HELM_X_CRYPTO_VERSION=${HELM_X_CRYPTO_VERSION}"
    --build-arg "HELM_PATCHED_GO_MOD_SHA256=${HELM_PATCHED_GO_MOD_SHA256}"
    --build-arg "HELM_PATCHED_GO_SUM_SHA256=${HELM_PATCHED_GO_SUM_SHA256}"
)
if [ -n "${DOCKER_BUILD_NETWORK:-}" ]; then
    build_args+=(--network "${DOCKER_BUILD_NETWORK}")
fi

docker build "${build_args[@]}" -t "$IMAGE" .

test "$(docker run --rm --entrypoint /usr/bin/helm "$IMAGE" version --template '{{ .Version }} {{ .GitCommit }} {{ .GitTreeState }} {{ .GoVersion }}')" \
    = "${HELM_VERSION} ${HELM_GIT_COMMIT} clean go1.27.0"
docker run --rm --entrypoint /usr/bin/kubectl "$IMAGE" version --client=true --output=json \
    | grep -Fq "${KUBERNETES_VERSION#v}"
test "$(docker image inspect "$IMAGE" --format '{{.Config.User}}')" = "65534:65534"
test "$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "io.pasturestack.kubernetes.version"}}')" = "$KUBERNETES_VERSION"
test "$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "io.pasturestack.helm.version"}}')" = "$HELM_VERSION"
test "$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "io.pasturestack.tools.compiler"}}')" = "go1.27.0"
test "$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "io.pasturestack.helm.oras-go.version"}}')" = "$HELM_ORAS_GO_VERSION"
test "$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "io.pasturestack.helm.x-crypto.version"}}')" = "$HELM_X_CRYPTO_VERSION"
test "$(docker run --rm --entrypoint /usr/bin/dpkg-query "$IMAGE" -W -f='${Version}' libc6)" = "$UBUNTU_APT_LIBC6_VERSION"
test "$(docker run --rm --entrypoint /usr/bin/dpkg-query "$IMAGE" -W -f='${Version}' libcurl4t64)" = "$UBUNTU_APT_LIBCURL4_VERSION"
test "$(docker run --rm --entrypoint /usr/bin/dpkg-query "$IMAGE" -W -f='${Version}' libssh2-1t64)" = "$UBUNTU_APT_LIBSSH2_VERSION"
test "$(docker run --rm --entrypoint /usr/bin/dpkg-query "$IMAGE" -W -f='${Version}' perl-base)" = "$UBUNTU_APT_PERL_BASE_VERSION"

chart_volume=$(docker volume create)
cleanup() {
    docker volume rm -f "$chart_volume" >/dev/null 2>&1 || true
}
trap cleanup EXIT
docker run --rm --user 0:0 -v "${chart_volume}:/chart" --entrypoint /bin/sh "$IMAGE" \
    -c "printf 'apiVersion: v2\nname: pasturestack-smoke\nversion: 0.1.0\n' > /chart/Chart.yaml"
rendered=$(docker run --rm -v "${chart_volume}:/chart:ro" --entrypoint /usr/bin/helm "$IMAGE" \
    install pasturestack-smoke /chart --dry-run=client --server-side=false --color=never --namespace pasturestack-smoke)
grep -Fq 'NAME: pasturestack-smoke' <<< "$rendered"

docker run --rm \
    --read-only \
    --tmpfs /home/pasturestack:rw,noexec,nosuid,nodev,size=32m,mode=1777 \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=8m,mode=1777 \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --entrypoint /bin/bash "$IMAGE" \
    -c '/usr/bin/update-platform-ca "$SSL_CERT_FILE" && test -s "$SSL_CERT_FILE" && /usr/bin/helm version --short >/dev/null && test "$(id -u):$(id -g)" = 65534:65534'

command -v trivy >/dev/null 2>&1 || {
    echo 'trivy is required for the release image scan and SBOM' >&2
    exit 1
}
mkdir -p ../dist
trivy image --skip-db-update --offline-scan --scanners vuln,secret \
    --severity CRITICAL,HIGH --exit-code 1 "$IMAGE"
trivy image --skip-db-update --offline-scan --format cyclonedx \
    --output ../dist/kubectl-service.cdx.json "$IMAGE"
docker run --rm --entrypoint /usr/bin/cat "$IMAGE" /licenses/KUBECTL-SERVICE-UBUNTU-APT-PACKAGES.tsv \
    > ../dist/kubectl-service-ubuntu-apt-packages.tsv
printf '%s\n' "$IMAGE" > ../dist/images
