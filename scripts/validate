#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

for script in scripts/* package/*.sh package/update-platform-ca tests/*.sh; do
    [ -f "$script" ] || continue
    bash -n "$script"
done

bash ./tests/test-helm4-entrypoint.sh
bash ./tests/test-non-root-runtime.sh
bash ./tests/test-release-gate.sh

test "$(grep -c '^FROM ' package/Dockerfile)" -eq 4
grep -Fq 'ARG KUBERNETES_VERSION=v1.36.4' package/Dockerfile
grep -Fq 'ARG HELM_VERSION=v4.2.4' package/Dockerfile
grep -Fq 'KUBERNETES_SOURCE_SHA256=3c28f11492472df48e658551bf268fd92938b127b0f9dcef7090ac800318c821' package/Dockerfile
grep -Fq 'HELM_SOURCE_SHA256=f1a1aa56fff071cfa1eecc18c6a7212b2e5c7a0a123fd8e4dcae620bd51b4286' package/Dockerfile
grep -Fq 'HELM_GIT_COMMIT=3900f434fd3ef2b84065dc04508df48f288dba00' package/Dockerfile
grep -Fq 'HELM_ORAS_GO_VERSION=2.6.2' package/Dockerfile
test "$(grep -c 'golang:1.27.0-bookworm@sha256:484ef6066fa69acb059fdfeda7ba2b8f7391f2ef6abc6f9b8411e669ebd56466' package/Dockerfile)" -eq 2
grep -Fq 'USER 65534:65534' package/Dockerfile
grep -Fq "UBUNTU_APT_SNAPSHOT='20260909T000000Z'" package/ubuntu-apt.lock
grep -Fq 'libc6="${UBUNTU_APT_LIBC6_VERSION}"' package/Dockerfile
grep -Fq 'libcurl4t64="${UBUNTU_APT_LIBCURL4_VERSION}"' package/Dockerfile
grep -Fq 'libssh2-1t64="${UBUNTU_APT_LIBSSH2_VERSION}"' package/Dockerfile
grep -Fq 'perl-base="${UBUNTU_APT_PERL_BASE_VERSION}"' package/Dockerfile
grep -Fq -- '--cap-drop ALL' scripts/package
grep -Fq -- '--security-opt no-new-privileges:true' scripts/package
grep -Fq 'ARG TRIVY_VERSION=0.74.0' Dockerfile.dapper
grep -Fq 'aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969' Dockerfile.dapper
expected_trivy_license_sha256='c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4'
actual_trivy_license_sha256=$(sha256sum build-tools/TRIVY-LICENSE | awk '{print $1}')
if [ "$actual_trivy_license_sha256" != "$expected_trivy_license_sha256" ]; then
    printf 'TRIVY-LICENSE checksum mismatch: expected %s, got %s\n' \
        "$expected_trivy_license_sha256" "$actual_trivy_license_sha256" >&2
    exit 1
fi
test ! -e build-tools/trivy-v0.73.0-oras-go-v2.6.2-go-git-v5.19.2.patch
if grep -E 'TRIVY_UPSTREAM_VERSION|trivy-security\.patch|GOEXPERIMENT=jsonv2' Dockerfile.dapper; then
    echo 'Retired custom Trivy rebuild path remains active' >&2
    exit 1
fi

active_paths=(main.go helm package scripts/package Makefile)
if grep -R -i -E 'helm[ -]?2|tiller|legacy-helm|v1\.12\.' "${active_paths[@]}"; then
    echo 'Removed EOL runtime path remains active' >&2
    exit 1
fi

go mod download
go mod verify
go mod tidy -diff
go vet -mod=vendor ./...
unformatted=$(gofmt -l main.go main_test.go helm/*.go)
if [ -n "$unformatted" ]; then
    printf 'Unformatted Go files:\n%s\n' "$unformatted" >&2
    exit 1
fi

grep -F 'github.com/sirupsen/logrus v1.10.2' vendor/modules.txt >/dev/null
grep -F 'github.com/urfave/cli/v3 v3.11.0' vendor/modules.txt >/dev/null
grep -F 'github.com/gorilla/websocket v1.5.3' vendor/modules.txt >/dev/null
grep -F 'golang.org/x/sys v0.47.0' vendor/modules.txt >/dev/null
if grep -R -n -E 'GO111MODULE=off|GO15VENDOREXPERIMENT|github.com/codegangsta/cli|github.com/rancher/swarm-agent' \
    --exclude=kubectl-service --exclude=validate --exclude-dir=.git --exclude-dir=bin --exclude-dir=dist --exclude-dir=third_party --exclude-dir=vendor .; then
    echo 'Retired GOPATH or dependency contract remains active' >&2
    exit 1
fi

echo 'KUBECTL_SERVICE_VALIDATE_OK kubernetes=v1.36.4 helm=v4.2.4 compiler=go1.27.0 oras-go=v2.6.2'
