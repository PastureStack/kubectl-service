        'sha256sum dist/*.json dist/*.tsv dist/*.lock' \
        'actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a' \
        'retention-days: 7'; do
        if ! grep -Fq -- "${required}" "${security_workflow}"; then
            fail KUBECTL_SERVICE_MANUAL_SECURITY_WORKFLOW_MARKER_MISSING "marker=${required}"
        fi
    done
    if grep -Eq 'uses:[^#]+@(main|master|v[0-9]+|[0-9]+\.[0-9]+)' "${security_workflow}"; then
        fail KUBECTL_SERVICE_UNPINNED_WORKFLOW_ACTION_PRESENT
    fi
    if grep -Eq '^[[:space:]]+(push|pull_request|pull_request_target|schedule):' "${security_workflow}"; then
        fail KUBECTL_SERVICE_AUTOMATIC_SECURITY_WORKFLOW_TRIGGER_PRESENT
    fi
fi
