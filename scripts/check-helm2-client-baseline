#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"
# shellcheck disable=SC1091
source migration/targets.lock.env
# shellcheck disable=SC1091
source package/ubuntu-apt.lock

failures=0
expected_version="v2.17.0"
expected_build_version="$HELM_BUILD_VERSION"
expected_helm_client_binary_sha256="$HELM_CLIENT_REBUILT_LINUX_AMD64_SHA256"
expected_tiller_binary_sha256="$TILLER_REBUILT_LINUX_AMD64_SHA256"
expected_go="1.26.5"
expected_helm_commit="a690bad98af45b015bd3da1a41f6218b1a451dbe"
expected_helm_patch_sha256="3bdf5475025db4d76afad26272f4848b2604c6e0e547b3aaf8243b48e16a9735"
expected_kubernetes_version="v1.12.10"
expected_kubernetes_commit="e3c134023df5dea457638b614ee17ef234dc34a6"
expected_kubernetes_sha512="201ca1af1c4fbecd598a8a6dc0ff5c865e4dab767ec2e768e8100b0c6c450c5ae1ab773aad9e5cdf3f61c15abf3a28f7c4640fbaaac097096905366acbd90a97"
expected_docker_cli_image="docker:29.6.2-cli@sha256:be132a9f282288de4afaf63379dff75711fda0147c6b72a9df44e51841402144"
expected_helm3_version="$HELM3_BRIDGE_VERSION"
expected_helm3_build_version="$HELM3_BRIDGE_BUILD_VERSION"
expected_helm3_commit="$HELM3_BRIDGE_GIT_COMMIT"
expected_helm3_source_sha256="$HELM3_BRIDGE_SOURCE_SHA256"
expected_helm3_license_sha256="$HELM3_BRIDGE_LICENSE_SHA256"
expected_helm3_patch_sha256="$HELM3_BRIDGE_APPLIED_PATCH_SHA256"
expected_helm3_binary_sha256="$HELM3_BRIDGE_REBUILT_LINUX_AMD64_SHA256"
expected_helm2to3_version="$HELM2TO3_VERSION"
expected_helm2to3_build_version="$HELM2TO3_BUILD_VERSION"
expected_helm2to3_commit="$HELM2TO3_GIT_COMMIT"
expected_helm2to3_source_sha256="$HELM2TO3_SOURCE_SHA256"
expected_helm2to3_license_sha256="$HELM2TO3_LICENSE_SHA256"
expected_helm2to3_patch_sha256="$HELM2TO3_APPLIED_PATCH_SHA256"
expected_helm2to3_binary_sha256="$HELM2TO3_REBUILT_LINUX_AMD64_SHA256"
expected_helm4_version="$HELM4_TARGET_VERSION"
expected_helm4_build_version="$HELM4_BUILD_VERSION"
expected_helm4_commit="$HELM4_TARGET_GIT_COMMIT"
expected_helm4_archive_sha256="$HELM4_TARGET_LINUX_AMD64_SHA256"
expected_helm4_source_sha256="$HELM4_TARGET_SOURCE_SHA256"
expected_helm4_license_sha256="$HELM4_TARGET_LICENSE_SHA256"
expected_helm4_security_patch_commit="$HELM4_SECURITY_PATCH_COMMIT"
expected_helm4_security_patch_sha256="$HELM4_SECURITY_PATCH_SHA256"
expected_helm4_applied_patch_sha256="$HELM4_APPLIED_PATCH_SHA256"
expected_helm4_oras_go_version="$HELM4_ORAS_GO_VERSION"
expected_helm4_binary_sha256="$HELM4_REBUILT_LINUX_AMD64_SHA256"

fail() {
    local code=$1
    shift || true
    echo "$code $*" | sed 's/[[:space:]]*$//'
    failures=$((failures + 1))
}

if [ "$UBUNTU_APT_SNAPSHOT" != '20260808T000000Z' ]; then
    fail KUBECTL_SERVICE_UBUNTU_APT_SNAPSHOT_DRIFT "actual=$UBUNTU_APT_SNAPSHOT expected=20260808T000000Z"
fi
if ! echo 'fcdb837261fcf690789153964ace4f0c01f3f318b836559ad3f4e31fcd051a7d  package/ubuntu-apt.lock' | sha256sum -c - >/dev/null; then
    fail KUBECTL_SERVICE_UBUNTU_APT_LOCK_HASH_DRIFT
fi
for name in \
    UBUNTU_APT_BASH_VERSION \
    UBUNTU_APT_BASH_COMPLETION_VERSION \
    UBUNTU_APT_CA_CERTIFICATES_VERSION \
    UBUNTU_APT_CURL_VERSION \
    UBUNTU_APT_FILE_VERSION \
    UBUNTU_APT_GCC_VERSION \
    UBUNTU_APT_GIT_VERSION \
    UBUNTU_APT_LIBC6_DEV_VERSION \
    UBUNTU_APT_MAKE_VERSION \
    UBUNTU_APT_NETCAT_OPENBSD_VERSION \
    UBUNTU_APT_PATCH_VERSION \
    UBUNTU_APT_TAR_VERSION \
    UBUNTU_APT_UTIL_LINUX_VERSION \
    UBUNTU_APT_XZ_UTILS_VERSION; do
    if ! grep -Fq "${name}='${!name}'" package/ubuntu-apt.lock; then
        fail KUBECTL_SERVICE_UBUNTU_APT_LOCK_VALUE_MISSING "name=$name"
    fi
    printf -v marker '=\"${%s}\"' "$name"
    if ! grep -Fq -- "$marker" Dockerfile.dapper package/Dockerfile; then
        fail KUBECTL_SERVICE_UBUNTU_APT_EXACT_VERSION_UNUSED "name=$name"
    fi
done
if grep -R -n -E 'UBUNTU_MIRROR|apt-get (update|install)' \
    Dockerfile.dapper package/Dockerfile Makefile scripts/package; then
    fail KUBECTL_SERVICE_MUTABLE_UBUNTU_APT_SOURCE_PRESENT
fi
if [ "$(grep -Fc 'apt-get --snapshot "${UBUNTU_APT_SNAPSHOT}"' Dockerfile.dapper)" -ne 4 ] || \
    [ "$(grep -Fc 'apt-get --snapshot "${UBUNTU_APT_SNAPSHOT}"' package/Dockerfile)" -ne 10 ]; then
    fail KUBECTL_SERVICE_UBUNTU_APT_SNAPSHOT_COVERAGE_DRIFT
fi
if [ "$(grep -Fc 'Acquire::https::CaInfo "/etc/ssl/certs/ca-certificates.crt";' Dockerfile.dapper)" -ne 2 ] || \
    [ "$(grep -Fc 'Acquire::https::CaInfo "/etc/ssl/certs/ca-certificates.crt";' package/Dockerfile)" -ne 5 ]; then
    fail KUBECTL_SERVICE_UBUNTU_APT_CA_COVERAGE_DRIFT
fi
for required in \
    'COPY --from=docker-cli /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt' \
    'COPY package/ubuntu-apt.lock /licenses/ubuntu-apt.lock' \
    'DAPPER-UBUNTU-APT-PACKAGES.tsv' \
    'TRIVY-BUILDER-UBUNTU-APT-PACKAGES.tsv' \
    'io.pasturestack.build.ubuntu.snapshot="20260808T000000Z"'; do
    if ! grep -Fq -- "$required" Dockerfile.dapper; then
        fail KUBECTL_SERVICE_DAPPER_UBUNTU_APT_EVIDENCE_MISSING "marker=$required"
    fi
done
for required in \
    "FROM ${expected_docker_cli_image} AS snapshot-ca-certificates" \
    'COPY --from=snapshot-ca-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt' \
    'COPY ubuntu-apt.lock /licenses/ubuntu-apt.lock' \
    'HELM2-BUILDER-UBUNTU-APT-PACKAGES.tsv' \
    'TILLER-UBUNTU-APT-PACKAGES.tsv' \
    'KUBECTL-EXTRACTOR-UBUNTU-APT-PACKAGES.tsv' \
    'HELM-MIGRATION-TOOLS-UBUNTU-APT-PACKAGES.tsv' \
    'KUBECTL-SERVICE-UBUNTU-APT-PACKAGES.tsv' \
    'io.pasturestack.ubuntu.snapshot="20260808T000000Z"'; do
    if ! grep -Fq -- "$required" package/Dockerfile; then
        fail KUBECTL_SERVICE_PRODUCT_UBUNTU_APT_EVIDENCE_MISSING "marker=$required"
    fi
done

if ! grep -qx "ARG HELM_VERSION=${expected_version}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM2_VERSION_DRIFT "actual=${actual:-missing} expected=ARG HELM_VERSION=${expected_version}"
fi
if ! grep -qx "ARG HELM_BUILD_VERSION=${expected_build_version}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM_BUILD_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM2_BUILD_VERSION_DRIFT "actual=${actual:-missing} expected=ARG HELM_BUILD_VERSION=${expected_build_version}"
fi
if ! grep -qx "ARG HELM_CLIENT_REBUILT_LINUX_AMD64_SHA256=${expected_helm_client_binary_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM_CLIENT_REBUILT_LINUX_AMD64_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM2_CLIENT_SHA256_DRIFT "actual=${actual:-missing} expected=ARG HELM_CLIENT_REBUILT_LINUX_AMD64_SHA256=${expected_helm_client_binary_sha256}"
fi
if ! grep -qx "ARG TILLER_REBUILT_LINUX_AMD64_SHA256=${expected_tiller_binary_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG TILLER_REBUILT_LINUX_AMD64_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_TILLER_SHA256_DRIFT "actual=${actual:-missing} expected=ARG TILLER_REBUILT_LINUX_AMD64_SHA256=${expected_tiller_binary_sha256}"
fi
if ! grep -qx "ARG GO_VERSION=${expected_go}" package/Dockerfile; then
    actual=$(grep -E '^ARG GO_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM2_GO_VERSION_DRIFT "actual=${actual:-missing} expected=ARG GO_VERSION=${expected_go}"
fi
if ! grep -qx "ARG HELM_GIT_COMMIT=${expected_helm_commit}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM_GIT_COMMIT=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM2_COMMIT_DRIFT "actual=${actual:-missing} expected=ARG HELM_GIT_COMMIT=${expected_helm_commit}"
fi
if ! grep -qx "ARG HELM_PATCH_SHA256=${expected_helm_patch_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM_PATCH_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM2_PATCH_DRIFT "actual=${actual:-missing} expected=ARG HELM_PATCH_SHA256=${expected_helm_patch_sha256}"
fi
if [ "$expected_go" != "$HELM_MIGRATION_GO_VERSION" ]; then
    fail KUBECTL_SERVICE_HELM_MIGRATION_GO_LOCK_DRIFT "build=${expected_go} migration_lock=${HELM_MIGRATION_GO_VERSION}"
fi
for name in \
    HELM3_BRIDGE_VERSION \
    HELM3_BRIDGE_BUILD_VERSION \
    HELM3_BRIDGE_GIT_COMMIT \
    HELM3_BRIDGE_SOURCE_SHA256 \
    HELM3_BRIDGE_LICENSE_SHA256 \
    HELM3_BRIDGE_APPLIED_PATCH_SHA256 \
    HELM3_BRIDGE_ORAS_GO_VERSION \
    HELM3_BRIDGE_X_TEXT_VERSION \
    HELM3_BRIDGE_REBUILT_LINUX_AMD64_SHA256 \
    HELM2TO3_VERSION \
    HELM2TO3_BUILD_VERSION \
    HELM2TO3_GIT_COMMIT \
    HELM2TO3_SOURCE_SHA256 \
    HELM2TO3_LICENSE_SHA256 \
    HELM2TO3_APPLIED_PATCH_SHA256 \
    HELM2TO3_HELM3_VERSION \
    HELM2TO3_ORAS_GO_VERSION \
    HELM2TO3_X_TEXT_VERSION \
    HELM2TO3_REBUILT_LINUX_AMD64_SHA256; do
    if ! grep -qx "ARG ${name}=${!name}" package/Dockerfile; then
        actual=$(grep -E "^ARG ${name}=" package/Dockerfile || true)
        fail KUBECTL_SERVICE_HELM_MIGRATION_BUILD_ARG_DRIFT "name=${name} actual=${actual:-missing} expected=ARG ${name}=${!name}"
    fi
done
if ! grep -qx "ARG HELM4_TARGET_VERSION=${expected_helm4_version}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_TARGET_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_VERSION_DRIFT "actual=${actual:-missing} expected=ARG HELM4_TARGET_VERSION=${expected_helm4_version}"
fi
if ! grep -qx "ARG HELM4_BUILD_VERSION=${expected_helm4_build_version}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_BUILD_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_BUILD_VERSION_DRIFT "actual=${actual:-missing} expected=ARG HELM4_BUILD_VERSION=${expected_helm4_build_version}"
fi
if ! grep -qx "ARG HELM4_TARGET_GIT_COMMIT=${expected_helm4_commit}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_TARGET_GIT_COMMIT=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_COMMIT_DRIFT "actual=${actual:-missing} expected=ARG HELM4_TARGET_GIT_COMMIT=${expected_helm4_commit}"
fi
if ! grep -qx "ARG HELM4_TARGET_SOURCE_SHA256=${expected_helm4_source_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_TARGET_SOURCE_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_SOURCE_SHA256_DRIFT "actual=${actual:-missing} expected=ARG HELM4_TARGET_SOURCE_SHA256=${expected_helm4_source_sha256}"
fi
if ! grep -qx "ARG HELM4_TARGET_LICENSE_SHA256=${expected_helm4_license_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_TARGET_LICENSE_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_LICENSE_SHA256_DRIFT "actual=${actual:-missing} expected=ARG HELM4_TARGET_LICENSE_SHA256=${expected_helm4_license_sha256}"
fi
if ! grep -qx "ARG HELM4_SECURITY_PATCH_COMMIT=${expected_helm4_security_patch_commit}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_SECURITY_PATCH_COMMIT=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_SECURITY_PATCH_COMMIT_DRIFT "actual=${actual:-missing} expected=ARG HELM4_SECURITY_PATCH_COMMIT=${expected_helm4_security_patch_commit}"
fi
if ! grep -qx "ARG HELM4_SECURITY_PATCH_SHA256=${expected_helm4_security_patch_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_SECURITY_PATCH_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_SECURITY_PATCH_SHA256_DRIFT "actual=${actual:-missing} expected=ARG HELM4_SECURITY_PATCH_SHA256=${expected_helm4_security_patch_sha256}"
fi
if ! grep -qx "ARG HELM4_APPLIED_PATCH_SHA256=${expected_helm4_applied_patch_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_APPLIED_PATCH_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_APPLIED_PATCH_SHA256_DRIFT "actual=${actual:-missing} expected=ARG HELM4_APPLIED_PATCH_SHA256=${expected_helm4_applied_patch_sha256}"
fi
if ! grep -qx "ARG HELM4_ORAS_GO_VERSION=${expected_helm4_oras_go_version}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_ORAS_GO_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_ORAS_GO_VERSION_DRIFT "actual=${actual:-missing} expected=ARG HELM4_ORAS_GO_VERSION=${expected_helm4_oras_go_version}"
fi
if ! grep -qx "ARG HELM4_REBUILT_LINUX_AMD64_SHA256=${expected_helm4_binary_sha256}" package/Dockerfile; then
    actual=$(grep -E '^ARG HELM4_REBUILT_LINUX_AMD64_SHA256=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_HELM4_REBUILT_SHA256_DRIFT "actual=${actual:-missing} expected=ARG HELM4_REBUILT_LINUX_AMD64_SHA256=${expected_helm4_binary_sha256}"
fi

if grep -Fq 'github.com/dgrijalva/jwt-go' package/helm-v2.17.0.go.mod; then
    fail KUBECTL_SERVICE_TILLER_RETIRED_JWT_LOCK_PRESENT "module=github.com/dgrijalva/jwt-go"
fi

if ! grep -Fq 'github.com/prometheus/client_golang v1.24.1' package/helm-v2.17.0.go.mod; then
    fail KUBECTL_SERVICE_TILLER_PROMETHEUS_LOCK_DRIFT "expected=github.com/prometheus/client_golang_v1.24.1"
fi

if ! grep -Fq 'diff --git a/cmd/tiller/tiller.go b/cmd/tiller/tiller.go' package/helm-compat-v2.17.0.patch; then
    fail KUBECTL_SERVICE_TILLER_CLOUD_AUTH_PATCH_MISSING "path=cmd/tiller/tiller.go"
fi
if ! grep -qx "ARG KUBERNETES_SOURCE_VERSION=${expected_kubernetes_version}" package/Dockerfile; then
    actual=$(grep -E '^ARG KUBERNETES_SOURCE_VERSION=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_KUBERNETES_VERSION_DRIFT "actual=${actual:-missing} expected=ARG KUBERNETES_SOURCE_VERSION=${expected_kubernetes_version}"
fi
if ! grep -qx "ARG KUBERNETES_SERVER_SHA512=${expected_kubernetes_sha512}" package/Dockerfile; then
    actual=$(grep -E '^ARG KUBERNETES_SERVER_SHA512=' package/Dockerfile || true)
    fail KUBECTL_SERVICE_KUBERNETES_ARCHIVE_SHA512_DRIFT "actual=${actual:-missing} expected=ARG KUBERNETES_SERVER_SHA512=${expected_kubernetes_sha512}"
fi
if [ "$KUBERNETES_SOURCE_VERSION" != "$expected_kubernetes_version" ] || \
    [ "$KUBERNETES_SOURCE_COMMIT" != "$expected_kubernetes_commit" ] || \
    [ "$KUBERNETES_SERVER_SHA512" != "$expected_kubernetes_sha512" ]; then
    fail KUBECTL_SERVICE_KUBERNETES_SOURCE_LOCK_DRIFT \
        "version=$KUBERNETES_SOURCE_VERSION commit=$KUBERNETES_SOURCE_COMMIT sha512=$KUBERNETES_SERVER_SHA512"
fi
if grep -qE 'helm-v2\.3\.0|ARG HELM_VERSION=v2\.3\.0' package/Dockerfile; then
    fail KUBECTL_SERVICE_HELM230_MARKER_PRESENT
fi
if grep -qE 'HELM_SHA256|helm-\$\{HELM_VERSION\}-linux-amd64' package/Dockerfile scripts/package Makefile; then
    fail KUBECTL_SERVICE_OFFICIAL_HELM_TARBALL_PATH_PRESENT
fi
if grep -qE 'get\.helm\.sh/helm-\$\{HELM3_BRIDGE_VERSION\}|helm-2to3/releases/download|helm-2to3_0\.11\.0_linux_amd64' package/Dockerfile scripts/package; then
    fail KUBECTL_SERVICE_VULNERABLE_MIGRATION_BINARY_DOWNLOAD_PRESENT
fi
if grep -qE 'glide install|Masterminds/glide|GLIDE_' package/Dockerfile scripts/package Makefile; then
    fail KUBECTL_SERVICE_FULL_GIT_DEPENDENCY_FETCH_PRESENT
fi
if grep -qE 'ARG KUBECTL_VERSION=v1\.36|KUBECTL_GIT_COMMIT|kubernetes/kubernetes.*/go build|component-base/version\.gitMinor=36' package/Dockerfile scripts/package Makefile; then
    fail KUBECTL_SERVICE_INCOMPATIBLE_KUBECTL_BUILD_PRESENT
fi
if ! grep -qx "FROM ${expected_docker_cli_image} AS docker-cli" Dockerfile.dapper; then
    actual=$(grep -E '^FROM docker:' Dockerfile.dapper || true)
    fail KUBECTL_SERVICE_DOCKER_CLI_IMAGE_DRIFT "actual=${actual:-missing} expected=${expected_docker_cli_image}"
fi
if ! grep -Fqx 'COPY --from=docker-cli /usr/local/bin/docker /usr/bin/docker' Dockerfile.dapper; then
    fail KUBECTL_SERVICE_DOCKER_CLI_COPY_MISSING
fi
if grep -qE 'download\.docker\.com/.+docker-\$\{DOCKER_VERSION\}\.tgz|ARG DOCKER_VERSION=' Dockerfile.dapper Makefile; then
    fail KUBECTL_SERVICE_UNVERIFIED_DOCKER_TARBALL_PRESENT
fi
if [ "$(awk '$1 == "USER" { user=$2 } END { print user }' Dockerfile.dapper)" != '65534:65534' ]; then
    fail KUBECTL_SERVICE_DAPPER_ROOT_DEFAULT_PRESENT
fi
if ! grep -Fq -- '--user "$$(id -u):$$(id -g)"' Makefile; then
    fail KUBECTL_SERVICE_DAPPER_HOST_USER_MAPPING_MISSING
fi
if ! grep -Fq -- '--group-add "$$(stat -c '\''%g'\'' /var/run/docker.sock)"' Makefile; then
    fail KUBECTL_SERVICE_DAPPER_DOCKER_SOCKET_GROUP_MISSING
fi
if ! grep -Fq -- '-e HOME=/tmp/pasturestack-dapper-home-$$(id -u)' Makefile ||
    ! grep -Fq -- '-e GOCACHE=/tmp/go-build-cache-$$(id -u)' Makefile ||
    ! grep -Fq -- '-e GOMAXPROCS=2' Makefile ||
    ! grep -Fq 'install -d -m 0700 "${HOME}" "${GOCACHE}" "${XDG_CONFIG_HOME}"' scripts/entry; then
    fail KUBECTL_SERVICE_DAPPER_PER_USER_CACHE_ISOLATION_MISSING
fi
if ! grep -Fq 'DOCKER_BUILDKIT ?= 1' Makefile ||
    ! grep -Fq -- '-e DOCKER_BUILDKIT=$(DOCKER_BUILDKIT)' Makefile ||
    ! grep -Fq 'DOCKER_BUILDKIT' Dockerfile.dapper; then
    fail KUBECTL_SERVICE_DAPPER_BUILDKIT_PROPAGATION_MISSING
fi
for required in \
    'FROM docker/buildx-bin:0.36.1@sha256:1f2f6b2be4a2511ada67336e76892f1a588c89746009dd4b21069e4d867465be AS buildx' \
    'ARG BUILDX_VERSION=0.36.1' \
    'ARG BUILDX_GIT_COMMIT=1d8dde89b8aba914e05e45366770736fea1fd690' \
    'COPY --from=buildx /buildx /usr/libexec/docker/cli-plugins/docker-buildx' \
    'docker buildx version | grep -F "github.com/docker/buildx v${BUILDX_VERSION} ${BUILDX_GIT_COMMIT}"'; do
    if ! grep -Fq -- "$required" Dockerfile.dapper; then
        fail KUBECTL_SERVICE_DAPPER_BUILDX_PIN_MISSING "marker=$required"
    fi
done
for required in \
    'FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03 AS trivy-builder' \
    'ARG TRIVY_VERSION=0.73.1' \
    'ARG TRIVY_GIT_COMMIT=40c73e5d6166dcc0346a1ab4e94499d1572854e4' \
    'ARG TRIVY_SOURCE_SHA256=dd35bec9570e1968b7a3d0d9f6504e5ac2f6a87eea0eee8ddcadd44d08940ee7' \
    'ARG TRIVY_PATCH_SHA256=ae0430b03044dff4b9b2e4115f1e5c156f623356aeb0e1213e4ae0f2c9dd8354' \
    'ARG TRIVY_GO_GIT_VERSION=5.19.2' \
    'COPY build-tools/trivy-v0.73.0-oras-go-v2.6.2-go-git-v5.19.2.patch /tmp/trivy-security.patch' \
    'GOMAXPROCS=2' \
    'GOEXPERIMENT=jsonv2 CGO_ENABLED=0 go build -p=2 -mod=readonly -trimpath -buildvcs=false' \
    'TRIVY-BUILDINFO.txt' \
    '$1 == "dep" && $2 == "github.com/go-git/go-git/v5" && $3 == "v5.19.2"' \
    '$1 == "dep" && $2 == "oras.land/oras-go/v2" && $3 == "v2.6.2"' \
    'COPY --from=trivy-builder /out/trivy /usr/local/bin/trivy' \
    'COPY --from=trivy-builder /out/TRIVY-BUILDINFO.txt /licenses/TRIVY-BUILDINFO.txt' \
    'test "$(trivy --version)" = "Version: ${TRIVY_VERSION}"'; do
    if ! grep -Fq -- "$required" Dockerfile.dapper; then
        fail KUBECTL_SERVICE_DAPPER_TRIVY_PIN_MISSING "marker=$required"
    fi
done
if grep -Fq 'FROM aquasec/trivy:' Dockerfile.dapper; then
    fail KUBECTL_SERVICE_DAPPER_UNPATCHED_TRIVY_IMAGE_PRESENT
fi
if ! echo 'ae0430b03044dff4b9b2e4115f1e5c156f623356aeb0e1213e4ae0f2c9dd8354  build-tools/trivy-v0.73.0-oras-go-v2.6.2-go-git-v5.19.2.patch' | sha256sum -c - >/dev/null; then
    fail KUBECTL_SERVICE_DAPPER_TRIVY_PATCH_HASH_DRIFT
fi
if ! echo '7d1151fa1cc9f9a383815454c3c3322c05c499cd76982f8bd4289547869616bd  build-tools/buildx-v0.36.1-docker-module-packages.txt' | sha256sum -c - >/dev/null || \
    ! grep -Fq 'CVE-2026-34040' security/openvex.json || \
    ! grep -Fq 'CVE-2026-41567' security/openvex.json || \
    ! grep -Fq 'CVE-2026-42306' security/openvex.json || \
    ! grep -Fq 'pkg:golang/github.com/docker/docker@v28.5.2%2Bincompatible' security/openvex.json || \
